# Copy this file to server/.env and fill in real values.

# ─── Database ──────────────────────────────────────────────────────────────
# Host-mode DB URL — used when running `node server.js` directly on the host.
# Inside docker-compose, this is overridden via the `environment:` block in
# docker-compose.yml (which points at the `postgres` service hostname).
DATABASE_URL=postgresql://smartcart:smartcart123@localhost:15432/smartcart?sslmode=disable

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8000
# Comma-separated list of allowed browser origins (CORS + Socket.io).
CORS=http://localhost:5173,http://localhost:4173
NODE_ENV=development
LOG_LEVEL=info

# ─── Auth ──────────────────────────────────────────────────────────────────
# Required for /api/login, /api/register, /api/refresh.
# Generate fresh values with e.g. `openssl rand -hex 64`.
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_RESET_SECRET=replace-me
JWT_EMAIL_SECRET=replace-me

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Used for email verification and password-reset links.
# Get a key at https://resend.com/api-keys.
# If RESEND_API_KEY is blank, /api/forgot-password logs the reset link to the
# console instead of emailing (dev convenience); /api/register will fail.
RESEND_API_KEY=

# Must be a verified Resend sender (your own domain) in production.
# If blank, the sandbox sender `SmartCart <onboarding@resend.dev>` is used,
# which only delivers to the email address that owns the Resend account.
FROM_EMAIL=SmartCart <noreply@yourdomain.com>

# Public URLs used to build links inside outgoing emails.
# BACKEND_URL  → where /api/verify-email is reachable (opened from the
#                verification email; the backend then 302s to FRONTEND_URL).
# FRONTEND_URL → where /reset-password and /verification-confirmed live.
# Both fall back to localhost in dev, but you MUST set them in production.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ─── Crawler (only needed if you run crawler.sh / crawl.ps1) ───────────────
# Absolute paths on the host machine.
PROJECT_DIR=/absolute/path/to/SmartCart/server
SERVER_DIR=/absolute/path/to/SmartCart/server
TARGET_DIR=/absolute/path/to/SmartCart/server/my_prices
DOCKER_PATH=docker
