# Copy this file to .env and fill in real values.
# docker-compose reads .env from the repo root for variable substitution.

# ─── Postgres ──────────────────────────────────────────────────────────────
# Postgres credentials. Must match the DATABASE_URL in server/.env when
# running the server outside Docker; inside Docker, docker-compose builds
# DATABASE_URL from these three values automatically.
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

# ─── pgAdmin ───────────────────────────────────────────────────────────────
# pgAdmin login (accessible at http://localhost:8080).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ─── Frontend build arg ────────────────────────────────────────────────────
# Baked into the frontend bundle at build time.
# Leave empty for the Docker setup: nginx proxies /api and /socket.io to the
# server, so the browser uses root-relative URLs.
# Set to an absolute URL (e.g. http://localhost:8000) only if the browser
# must reach a different origin than the page it was served from.
VITE_API_URL=
